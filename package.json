{
  "name": "Onyx",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "deploy": "bun run --cwd apps/web deploy",
    "build:vault": "bun run scripts/build-vault.ts",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "check": "vp check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web && tsc --noEmit -p packages/vault"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
