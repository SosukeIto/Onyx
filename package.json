	"dependencies": {
		"@Onyx/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@Onyx/config": "workspace:*",
		"@biomejs/biome": "^2.5.6",
		"@types/bun": "catalog:",
		"lefthook": "^2.1.10",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.4.0"
}
